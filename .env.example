# Salin ke .env lalu sesuaikan nilainya.
# Jangan commit file .env yang berisi kredensial asli.

# --- Database ---
# Untuk development lokal (embedded-postgres), kedua URL ini sama.
# Untuk produksi (Supabase/Neon), DATABASE_URL memakai pooler dan
# DIRECT_URL memakai koneksi langsung untuk migrasi.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:54329/portfolio_cms?schema=public"
DIRECT_URL="postgresql://portfolio:portfolio@localhost:54329/portfolio_cms?schema=public"

# --- Auth.js ---
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
AUTH_TRUST_HOST=true

# --- Situs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Akun admin awal (dipakai oleh prisma/seed.ts) ---
ADMIN_EMAIL="admin@portofolio.local"
ADMIN_PASSWORD="Admin#12345"

# --- CMS ---
# true  = dashboard admin aktif (untuk di laptop).
# Kosongkan/false di Vercel agar admin tidak bisa diakses dari hosting.
CMS_ENABLED="true"

# --- Supabase Storage (upload media dari CMS) ---
# Jika dikosongkan, upload memakai penyimpanan lokal `public/uploads/`
# (hanya untuk development; gambar tidak ikut ke Vercel).
# Ambil URL & anon key dari Project Settings → API.
# Service role key hanya dipakai di server (jangan pernah diekspos ke browser).
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_STORAGE_BUCKET="portofolio"
