// Prisma schema — Personal Portfolio CMS
// Acuan: PRD v1.0 bagian 7 (Rancangan Data dan Relasi)
// Versi Prisma: 6.19.x (generator prisma-client-js, datasource url dari env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Koneksi langsung (tanpa pooler) untuk migrasi/introspeksi Prisma.
  // Di Supabase/Neon, DATABASE_URL memakai pooler dan DIRECT_URL memakai
  // koneksi langsung. Untuk database lokal, isi keduanya dengan URL yang sama.
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

/// Akun administrator (versi pertama: satu akun, tanpa registrasi publik)
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Profil pemilik website (satu record utama)
model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  headline     String?
  profession   String?
  bio          String?  @db.Text
  profileImage String?
  contactEmail String?
  location     String?
  cvFile       String?
  githubUrl    String?
  linkedinUrl  String?
  instagramUrl String?
  twitterUrl   String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Proyek portofolio
model Project {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  slug             String          @unique
  shortDescription String
  description      String          @db.Text
  thumbnail        String
  technologies     String[]        @default([])
  demoUrl          String?
  githubUrl        String?
  projectDate      DateTime?
  isFeatured       Boolean         @default(false)
  status           ProjectStatus   @default(DRAFT)
  categories       Category[]
  images           ProjectImage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
}

/// Kategori proyek (many-to-many dengan Project)
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Galeri gambar proyek (one-to-many dari Project)
model ProjectImage {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  imagePath    String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Keahlian, dikelompokkan lewat kolom groupName (mis. Frontend, Backend, Tools)
model Skill {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  groupName    String?
  level        Int?
  icon         String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([groupName, displayOrder])
  @@index([isActive])
}

/// Riwayat pengalaman kerja/organisasi
model Experience {
  id           String    @id @default(uuid()) @db.Uuid
  position     String
  organization String
  location     String?
  description  String?   @db.Text
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
}

/// Riwayat pendidikan
model Education {
  id           String    @id @default(uuid()) @db.Uuid
  institution  String
  program      String
  level        String?
  description  String?   @db.Text
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
}

/// Sertifikat
model Certificate {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  issuer        String
  issuedAt      DateTime?
  credentialUrl String?
  imagePath     String?
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([displayOrder])
}

/// Pesan dari formulir kontak pengunjung
model Message {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Pengaturan website berbentuk key-value (SEO, footer, sosial, favicon, dll.)
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
